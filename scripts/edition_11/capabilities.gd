	# Detachments.
	"combat-doctrines": {"category": CATEGORY_FACTION, "name": "Combat Doctrines (11e)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Selected Marine doctrine applies to units carrying the exported Combat Doctrines ability, including Lieutenant, Phobos Lieutenant and Vulkan He’stan; locally checked across command selection, fallback eligibility and charge/advance effects; remaining faction combinations are bounded"},
	"seeker-of-the-unfound": {"category": CATEGORY_UNIT, "name": "Seeker of the Unfound", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Vulkan He’stan selects one battlefield objective after deployment; while he is within range of it, his OC is 10, Leadership is 5+, and he has Feel No Pain 4+"},
	"forgefather": {"category": CATEGORY_FACTION, "name": "Forgefather", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Once in Vulkan He’stan’s Shooting phase, select one visible enemy unit within 24 inches; friendly Adeptus Astartes Melta and Torrent attacks against it gain +2 Strength for that phase"},
	"codex-discipline": {"category": CATEGORY_DETACHMENT, "name": "Codex Discipline (Gladius extra doctrine use)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "One Combat Doctrine can be selected one additional time per battle; that extra use is shared across the three doctrines."},
	"mastered-doctrines": {"category": CATEGORY_DETACHMENT, "name": "Mastered Doctrines (Blade of Ultramar)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "If the army includes Marneus Calgar, each Combat Doctrine can be selected one additional time per battle. Each doctrine has its own extra use. Requires Blade of Ultramar and Ultramarines Chapter context. All four enhancements, Armour of Contempt, Courage and Honour!, Exemplary Vigilance, Ultramarian Adaptivity, and Practical Tactics have local runtime paths; one of six stratagems remains unavailable. Focused local checks and current official rule locators are pending; full army legality and network validation are uncertified."},
	"ultramarines-armour-of-contempt": {"category": CATEGORY_STRATAGEM, "name": "Armour of Contempt (Blade of Ultramar)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "1 CP; opponent Shooting or Fight phase when an enemy targets a friendly Adeptus Astartes unit. The shared attack-declaration response binds -1 AP to attacks from that triggering enemy unit through its current attack sequence. Requires Blade of Ultramar and Ultramarines Chapter context. Focused local checks and exact current erratum applicability remain pending."},
	"ultramarines-courage-and-honour": {"category": CATEGORY_STRATAGEM, "name": "Courage and Honour! (Blade of Ultramar)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "1 CP; Fight phase when a friendly Adeptus Astartes unit is selected to fight. The shared melee-profile path adds Lance to that unit's melee attacks for the phase, using the Core Lance wound bonus only when the unit charged. Requires Blade of Ultramar and Ultramarines Chapter context. Focused local checks and the current official full-rule locator remain pending."},
	"ultramarines-exemplary-vigilance": {"category": CATEGORY_STRATAGEM, "name": "Exemplary Vigilance (Blade of Ultramar)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "1 CP; your Shooting phase when a friendly Adeptus Astartes unit is selected to shoot. Its ranged attacks gain Ignores Cover for the phase through the shared ranged-profile path. Requires Blade of Ultramar and Ultramarines Chapter context. Focused local checks and the current official full-rule locator remain pending."},
	"ultramarines-adaptivity": {"category": CATEGORY_STRATAGEM, "name": "Ultramarian Adaptivity (Blade of Ultramar)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "1 CP; your Command phase, one friendly Adeptus Astartes unit chooses one Combat Doctrine active for it until the start of your next Command phase. Uses the per-unit doctrine override and expiry path. Requires Blade of Ultramar and Ultramarines Chapter context. Focused local checks and the current official full-rule locator remain pending."},
	"ultramarines-practical-tactics": {"category": CATEGORY_STRATAGEM, "name": "Practical Tactics (Blade of Ultramar)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "1 CP; in your opponent's Movement phase, after an enemy unit ends a move within 8 inches of an unengaged friendly Adeptus Astartes Infantry or Mounted unit, that unit can make a Normal Move up to D3+3 inches. Uses the post-move reaction, die and placement preview path. Requires Blade of Ultramar and Ultramarines Chapter context. Focused local checks and the current official full-rule locator remain pending."},
	"ultramarines-tactical-foresight": {"category": CATEGORY_STRATAGEM, "name": "Tactical Foresight (Blade of Ultramar)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "1 CP; opponent Shooting or Fight phase when an enemy targets a friendly Adeptus Astartes unit. Attacks by that triggering enemy against the selected unit have -1 to Wound when Strength exceeds Toughness, through the current attack sequence. Uses the persisted defensive attack-declaration response and shared wound-modifier path. Requires Blade of Ultramar and Ultramarines Chapter context. Focused local checks and the current official full-rule locator remain pending."},
	"student-of-the-codex": {"category": CATEGORY_ENHANCEMENT, "name": "Student of the Codex (Blade of Ultramar)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "20 points; the export relation links 11 source datasheets and the current local catalog admits six Captain profiles: Captain (000000073), Captain with Jump Pack (000000083), Captain in Terminator Armour (000000135), Captain in Gravis Armour (000001172), Captain in Phobos Armour (000002701) and Captain on Bike (000002702). When selected in Blade of Ultramar, the enhanced unit has Tactical Doctrine active alongside its other doctrine. Focused local checks, network validation and full army legality remain pending."},
	"armour-of-antoninus": {"category": CATEGORY_ENHANCEMENT, "name": "Armour of Antoninus (Blade of Ultramar)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "15 points; enhancement row 000010633003 has relations to 37 datasheets, 23 of which resolve to current consolidated Marine profiles. It is selectable for an eligible non-Epic-Hero Adeptus Astartes Character bearer in Blade of Ultramar; that model has a 2+ Save and Feel No Pain 5+ against any wound. Focused local checks, network validation and full army legality remain pending."},
	"oath-of-macragge": {"category": CATEGORY_ENHANCEMENT, "name": "Oath of Macragge (Blade of Ultramar)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "20 points; enhancement row 000010633004 has the same 37 export-linked datasheets as Armour of Antoninus, 23 of which resolve to current consolidated Marine Character profiles. It is selectable for an eligible non-Epic-Hero Adeptus Astartes Character bearer in Blade of Ultramar; the bearer's melee attacks gain +1 Strength and AP, or +2 Strength and AP while Assault Doctrine is active for its unit. Focused local checks, network validation and full army legality remain pending."},
	"veteran-of-behemoth": {"category": CATEGORY_ENHANCEMENT, "name": "Veteran of Behemoth (Blade of Ultramar)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "20 points; enhancement row 000010633005 has the same 37 export-linked datasheets, 23 of which resolve to current consolidated Marine Character profiles. It is selectable for an eligible non-Epic-Hero Adeptus Astartes Character bearer in Blade of Ultramar; the bearer's unit gains Sustained Hits 1 for its ranged attacks through the shared attack-profile path. A stronger existing Sustained Hits value is preserved. Focused local checks, network validation and full army legality remain pending."},
	"lightning-fast-strike": {"category": CATEGORY_DETACHMENT, "name": "Lightning-fast Strike (Stormlance)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Friendly Adeptus Astartes Mounted and Speeder units have +2 inches Movement; applies to Normal, Advance and Fall Back movement through the unit's Movement characteristic."},
	"enduring-vengeance": {"category": CATEGORY_DETACHMENT, "name": "Enduring Vengeance (Ironclad Champions)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "tests_passed_local_targeted", "scope": "Friendly Adeptus Astartes Dreadnought units re-roll hit rolls of 1; snap-shooting remains ineligible for hit re-rolls."},
	"assault-brethren-mastery": {"category": CATEGORY_DETACHMENT, "name": "Assault Mastery (Assault Brethren)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Assault Doctrine may be selected one additional time per battle; this extra use is fixed to Assault Doctrine."},
	"tactical-brethren-mastery": {"category": CATEGORY_DETACHMENT, "name": "Tactical Mastery (Tactical Brethren)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "tests_passed_local_targeted", "scope": "Tactical Doctrine may be selected one additional time per battle; this extra use is fixed to Tactical Doctrine."},
	"devastator-brethren-mastery": {"category": CATEGORY_DETACHMENT, "name": "Devastator Mastery (Devastator Brethren)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Devastator Doctrine may be selected one additional time per battle; this extra use is fixed to Devastator Doctrine."},
	"death-blow": {"category": CATEGORY_DETACHMENT, "name": "Death Blow (Terminator Storm Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "tests_passed_local_targeted", "scope": "Friendly Adeptus Astartes Terminator units add 1 to Charge rolls; the modifier is resolved through the shared charge-roll path."},
	"champion-of-first-company": {"category": CATEGORY_ENHANCEMENT, "name": "Champion of the First Company (Terminator Storm Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "implemented_local_checks_pending", "scope": "20 points; the local export links four current-catalog Terminator identities to this enhancement: Librarian (000000079), Chaplain (000000115), Captain (000000135), and Ancient (000002677). Source IDs now bind all four profiles for this enhancement. The Ancient profile retains its documented DEATHWING keyword omission; this does not change the source-mapped Astartes Terminator eligibility. While its living bearer remains in a Terminator Storm Force unit, the unit's melee attacks gain Lethal Hits through the shared attack-profile path. Focused local checks remain pending; full army legality is not certified."},
	"corporeum-reliquary": {"category": CATEGORY_ENHANCEMENT, "name": "Corporeum Reliquary (Terminator Storm Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "implemented_local_checks_pending", "scope": "25 points; the local export links four current-catalog Terminator identities to this enhancement: Librarian (000000079), Chaplain (000000115), Captain (000000135), and Ancient (000002677). Source IDs now bind all four profiles for this enhancement. The Ancient profile retains its documented DEATHWING keyword omission; this does not change the source-mapped Astartes Terminator eligibility. During battle round 1, its living bearer lets the unit make an ingress move in its owner's first Movement phase through the shared reserve placement path. This does not enable opponent-turn Rapid Ingress. Focused local checks remain pending; full army legality is not certified."},
	"terminator-merciless-veterans": {"category": CATEGORY_STRATAGEM, "name": "Merciless Veterans (Terminator Storm Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "implemented_local_checks_pending", "scope": "1 CP when a friendly Adeptus Astartes Terminator unit is selected to shoot in your Shooting phase. Its ranged attacks gain Lethal Hits and Sustained Hits 1 for the phase through the shared attack-profile path. The choice suspends and resumes the same attack declaration. Focused local checks remain pending; full army legality is not certified."},
	"terminator-tactical-dreadnought-fortitude": {"category": CATEGORY_STRATAGEM, "name": "Tactical Dreadnought Fortitude (Terminator Storm Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "implemented_local_checks_pending", "scope": "2 CP in the opponent's Shooting or Fight phase when an enemy unit targets a friendly Adeptus Astartes Terminator unit. The attack declaration suspends for a use/pass choice; if used, attacks by that declared enemy activation targeting the chosen unit have -1 Damage, minimum 1, through the shared damage-allocation path. Focused local checks remain pending; full army legality is not certified."},
	"terminator-gunship-extraction": {"category": CATEGORY_STRATAGEM, "name": "Gunship Extraction (Terminator Storm Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "implemented_local_checks_pending", "scope": "1 CP at the end of the opponent's Fight phase to place one friendly, unengaged Adeptus Astartes Terminator unit in Strategic Reserves. The end-phase choice uses the shared reserve state and removes the unit from the battlefield; the local profile must have admitted reserve points. Focused local checks remain pending; full army legality is not certified."},
	"codex-fire-patterns": {"category": CATEGORY_DETACHMENT, "name": "Codex Fire-patterns (Tacticus Firestorm Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "tests_passed_local_targeted", "scope": "Friendly Tacticus units receive their Rapid Fire bonus when targeting an enemy unit at any distance within the firing weapon's maximum range."},
	"tacticus-firestorm-for-the-emperor": {"category": CATEGORY_STRATAGEM, "name": "For the Emperor! (Tacticus Firestorm Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "1 CP in your Command phase: one friendly Tacticus unit within objective range gains +1 OC until end of turn through the shared model objective-control path. Uses the shared CP discount and once-per-phase/unit stratagem limits. Focused local checks and playtesting are pending; network validation and full army legality are uncertified."},
	"tacticus-firestorm-relentless-assault": {"category": CATEGORY_STRATAGEM, "name": "Relentless Assault (Tacticus Firestorm Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "1 CP when a friendly Tacticus unit is selected to attack in your Shooting phase or the Fight phase. Until end of phase, its attacks gain Sustained Hits 1 against targets with neither MONSTER nor VEHICLE, or Lethal Hits against targets with either keyword. Firestorm uses the shared persisted attack-declaration response and per-target weapon-profile path while retaining this source-specific capability. Focused local checks and playtesting are pending; network validation and full army legality are uncertified."},
	"tacticus-firestorm-point-blank-brutality": {"category": CATEGORY_STRATAGEM, "name": "Point-Blank Brutality (Tacticus Firestorm Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "1 CP in your Shooting phase when a friendly engaged TACTICUS unit is selected to shoot. The persisted pre-resolution attack response offers use/pass before weapon validation is finalized; if used, its ranged attacks excluding Blast gain Close-Quarters and Ignores Cover through the shared weapon profile path. Uses the shared CP discount and once-per-phase/unit stratagem limits. Focused local checks and playtesting are pending; network validation and full army legality are uncertified."},
	"wrath-of-the-chapter": {"category": CATEGORY_DETACHMENT, "name": "Wrath of the Chapter (Tacticus Attack Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "tests_passed_local_targeted", "scope": "Friendly Tacticus units may re-roll their Advance roll once after the roll and before movement, at no CP cost."},
	"tacticus-tactical-focus": {"category": CATEGORY_STRATAGEM, "name": "Tactical Focus (Tacticus Attack Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "implemented_local_checks_pending", "scope": "1 CP when a friendly Tacticus unit is selected to consolidate in either player's Fight phase; roll D3+3 inches, start and confirm the consolidation through the shared contact placement flow, and retain the paid roll when placement is cancelled. Focused local checks and playtesting remain pending; network validation and full army legality are uncertified."},
	"tacticus-transhuman-swiftness": {"category": CATEGORY_STRATAGEM, "name": "Transhuman Swiftness (Tacticus Attack Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "1 CP after an enemy unit has fought in the Fight phase: one eligible friendly Tacticus unit within objective range gains Fights First and is locked as the next unit selected to fight. This also supports a unit required to fight by the forced consolidation-reaction queue; the selected unit is inserted and the outstanding queue resumes after it fights. A selection that resolves without attacks does not open this window. Uses the shared post-fight decision and stratagem limit/discount path. Focused local checks and playtesting remain pending; network validation and full army legality are uncertified."},
	"tacticus-attack-relentless-assault": {"category": CATEGORY_STRATAGEM, "name": "Relentless Assault (Tacticus Attack Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "implemented_local_checks_pending", "scope": "1 CP when an eligible Tacticus unit is selected to attack in your Shooting phase or the Fight phase. Until end of phase, its attacks gain Sustained Hits 1 against targets with neither MONSTER nor VEHICLE, or Lethal Hits against targets with either keyword. Attack declarations select and resume the stratagem response; target type is resolved per target unit through the shared weapon-profile path. Focused local checks and playtesting remain pending; network validation and full army legality are uncertified."},
	"spearpoint-war-leader": {"category": CATEGORY_ENHANCEMENT, "name": "Spearpoint War Leader (Tacticus Attack Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "implemented_local_checks_pending", "scope": "15 points; the verified export relation maps this enhancement to 11 Tacticus bearer identities in the current local catalog. The bearer's unit gains Scouts 6 through the shared pre-battle Scout movement and reserve set-up flow. Focused local checks and human playtesting remain pending; network validation and full army legality are uncertified."},
	"martial-paragon": {"category": CATEGORY_ENHANCEMENT, "name": "Martial Paragon (Tacticus Attack Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "10 points; the verified export relation maps this enhancement to 11 Tacticus bearer identities in the current local catalog. During one attack declaration, the bearer unit can re-roll one Hit roll and one Wound roll across its attacks. Uses the shared persisted hit/wound checkpoints, including target splits. Focused local checks and human playtesting remain pending; network validation and full army legality are uncertified."},
	"cyber-familiar": {"category": CATEGORY_ENHANCEMENT, "name": "Cyber-familiar (Tacticus Firestorm Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "15 points; the verified export relation maps this enhancement to 11 current-catalog Tacticus bearers. After both armies deploy, the bearer’s owner can redeploy up to three deployed Adeptus Astartes Infantry units within the normal deployment restrictions or place them in Strategic Reserves regardless of the normal limit. This resolves before Scout moves. Embarked units are not selectable, and reserve placement requires a locally admitted points cost. Focused checks and human playtesting remain pending; network validation and full army legality are uncertified."},
	"tacticus-firestorm-tempered-in-battle": {"category": CATEGORY_ENHANCEMENT, "name": "Tempered in Battle (Aura) (Tacticus Firestorm Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "10 points; the verified export relation maps this enhancement to 11 current-catalog Tacticus bearers. Friendly Adeptus Astartes units within 6 inches of the living bearer can optionally re-roll both dice for supported Leadership tests through the shared existing Tempered in Battle choice path. Focused local checks and playtesting are pending; network validation and full army legality are uncertified."},
	"walking-fortress": {"category": CATEGORY_DETACHMENT, "name": "Walking Fortress (Gravis Linebreaker Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "tests_passed_local_targeted", "scope": "For the turn after a friendly Gravis unit makes a Normal move, its ranged attacks lose Heavy and gain +1 to Hit."},
	"indefatigable-fortitude": {"category": CATEGORY_ENHANCEMENT, "name": "Indefatigable Fortitude (Gravis Linebreaker Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "implemented_local_checks_pending", "scope": "20 points; local export eligibility restricts this bearer enhancement to Apothecary Biologis and Captain in Gravis Armour. When active in Gravis Linebreaker Force, attacks with Strength greater than the unit's Toughness suffer -1 to Wound through the shared defensive modifier. Focused local checks remain pending; full army legality is not certified."},
	"relentless-advance": {"category": CATEGORY_ENHANCEMENT, "name": "Relentless Advance (Gravis Linebreaker Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "implemented_local_checks_pending", "scope": "20 points; local export eligibility restricts this bearer enhancement to Apothecary Biologis and Captain in Gravis Armour. When active in Gravis Linebreaker Force, the unit gains Scouts 5 through the existing pre-battle Scout movement and set-up flow. Focused local checks remain pending; full army legality is not certified."},
	"gravis-linebreaker-annihilating-force": {"category": CATEGORY_STRATAGEM, "name": "Annihilating Force (Gravis Linebreaker Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "implemented_local_checks_pending", "scope": "1 CP when a friendly GRAVIS unit is selected to attack in your Shooting or Fight phase; the owner can use the current attack-declaration choice to give that unit's attacks Lethal Hits for the phase. The modifier uses the shared weapon-profile path. Focused local checks remain pending; full army legality is not certified."},
	"gravis-linebreaker-purgation-push": {"category": CATEGORY_STRATAGEM, "name": "Purgation Push (Gravis Linebreaker Force)", "supported": true, "source_status": "wahapedia_e11_faction_page_app_2_8_1_observed_2026_10_25", "validation_status": "implemented_local_checks_pending", "scope": "1 CP after a friendly unengaged GRAVIS unit shoots in your Shooting phase; make a Normal Move up to 5 inches, ending within range of an objective. The unit cannot Charge or embark in a Transport until the end of the turn. Placement uses shared movement validation. Focused local checks remain pending; full army legality is not certified."},
	"indomitable-defence": {"category": CATEGORY_DETACHMENT, "name": "Indomitable Defence (Gravis Siege Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "implemented_local_checks_pending", "scope": "While a friendly GRAVIS unit is within range of an objective, incoming attacks with Strength greater than that unit's Toughness receive -1 to Wound. The modifier enters the shared defensive wound calculation and remains subject to its -1 cap. Narthecis Gauntlet is available through the local enhancement picker and uses shared healing allocation. Focused Gravis checks remain pending; full army legality is not certified."},
	"immovable-conquerors": {"category": CATEGORY_ENHANCEMENT, "name": "Immovable Conquerors (Gravis Siege Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "implemented_local_checks_pending", "scope": "15 points; the export relation and GRAVIS keyword allow seven current-catalog identities: Apothecary Biologis, Inceptor Squad, Captain in Gravis Armour, Heavy Intercessor Squad, Aggressor Squad, and both Eradicator Squad loadout profiles. When the enhanced unit's owner has selected Gravis Siege Force, its models contribute +1 OC through the shared objective-control path. The source relation excludes Iron Father Feirros and Tor Garadon. Narthecis Gauntlet remains limited to Apothecary Biologis and heals D3+1 wounds in the Command phase through shared healing allocation. Focused Gravis checks remain pending; full army legality is not certified."},
	"narthecis-gauntlet": {"category": CATEGORY_ENHANCEMENT, "name": "Narthecis Gauntlet (Gravis Siege Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "implemented_local_checks_pending", "scope": "20 points; export-mapped only to the Apothecary Biologis model in the consolidated local Marine catalog. In your Command phase, the unit receives a D3+1 healing budget through the shared wounded-model allocation and eligible non-Character return flow. Focused local checks remain pending; full army legality is not certified."},
	"gravis-siege-annihilating-force": {"category": CATEGORY_STRATAGEM, "name": "Annihilating Force (Gravis Siege Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "implemented_local_checks_pending", "scope": "1 CP when a friendly GRAVIS unit is selected to attack in your Shooting or Fight phase; the owner can use the current attack-declaration choice to give that unit's attacks Lethal Hits for the phase. The modifier uses the shared weapon-profile path. Focused local checks remain pending; full army legality is not certified."},
	"gravis-siege-stand-unyielding": {"category": CATEGORY_STRATAGEM, "name": "Stand Unyielding (Gravis Siege Force)", "supported": true, "source_status": "wahapedia_e11_faction_page_app_2_8_1_observed_2026_10_25", "validation_status": "implemented_local_checks_pending", "scope": "1 CP in the active player's Movement phase end window; a friendly GRAVIS unit that contributes positive OC to an objective its army controls may secure one such objective. Uses the shared secure-effect and objective control paths. Focused local checks remain pending; full army legality is not certified."},
	"gravis-siege-suppression-volleys": {"category": CATEGORY_STRATAGEM, "name": "Suppression Volleys (Gravis Siege Force)", "supported": true, "source_status": "wahapedia_e11_faction_page_app_2_8_1_observed_2026_10_25", "validation_status": "implemented_local_checks_pending", "scope": "1 CP in your Shooting phase after a friendly GRAVIS unit has shot; choose one living enemy unit hit by that unit's attacks and make its Battle-shock roll at -1. The target controller may use an available Tempered in Battle re-roll. Focused local checks remain pending; full army legality is not certified."},
	"gravis-linebreaker-armoured-impact": {"category": CATEGORY_STRATAGEM, "name": "Armoured Impact (Gravis Linebreaker Force)", "supported": true, "source_status": "wahapedia_e11_faction_page_app_2_8_1_observed_2026_10_25", "validation_status": "implemented_local_checks_pending", "scope": "1 CP after a friendly GRAVIS unit ends a Charge move; choose one engaged enemy unit, roll one D6 for each friendly model engaged with it, and inflict one mortal wound for each 3+. Uses the bounded post-charge choice and shared mortal-wound allocation/prevention path. Focused local checks remain pending; full army legality is not certified."},
	"dutiful-tenacity": {"category": CATEGORY_DETACHMENT, "name": "Dutiful Tenacity (Wrath of the Rock)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "tests_passed_local_targeted", "scope": "When attack Strength exceeds Toughness, attacks targeting friendly Adeptus Astartes Infantry/Mounted units suffer -1 to Wound. The focused rule effect passes; prepared-match admission now applies the represented Chapter restriction, while conditional Deathwing/Ravenwing chapter rules and full Dark Angels army legality remain outside this gate; admission checks are pending."},
	"storm-swift-onslaught": {"category": CATEGORY_DETACHMENT, "name": "Storm-swift Onslaught (Spearpoint Task Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_22", "validation_status": "tests_passed_local_targeted", "scope": "Assault or Tactical Doctrine can be selected one additional time per battle; friendly Adeptus Astartes Mounted/Speeder units add 1 to Advance rolls. At Fight-phase end, if Suboden Khan's unit was eligible to fight this phase, it can make a Normal Move if unengaged or a Fall Back move if engaged, using each model's Movement characteristic. Focused local checks cover doctrine availability, Advance eligibility, the absence of charge permissions, Suboden's trigger, engagement-dependent move and distance. Prepared-match admission applies the represented White Scars Chapter restriction; separate admission checks remain pending, and full army legality/network validation are not certified."},
	"ironstorm-auto-targeters": {"category": CATEGORY_DETACHMENT, "name": "Ironstorm Auto-targeters (Ironstorm Spearhead)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "A friendly Adeptus Astartes Vehicle unit, excluding Walkers, can optionally re-roll one Hit roll and one Wound roll during each ranged attack activation. The existing attack choice windows enforce one of each per activation; no CP is spent."},
	"vanguard-ambushers": {"category": CATEGORY_DETACHMENT, "name": "Vanguard Ambushers (Phobos Shock Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "tests_passed_local_targeted", "scope": "At the end of the owner's Movement phase, a friendly unit with the PHOBOS keyword is marked through that turn if at least one living model is Hidden. Hidden uses the local model-level terrain proxy, including Light/Dense-area membership and firing history; marked Shooting and Fight attacks re-roll Wound rolls of 1."},
	"phobos-shock-strike-from-the-shadows": {"category": CATEGORY_STRATAGEM, "name": "Strike from the Shadows (Phobos Shock Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26", "validation_status": "implemented_local_checks_pending", "scope": "1 CP when a friendly hidden PHOBOS unit is selected to attack in its Shooting or Fight phase. Its attacks gain +1 Strength and Lethal Hits through the shared attack-profile path. The persisted declaration offers use or pass. A unit is treated as hidden when all of its living models satisfy the local model-level Hidden check. Focused checks and playtesting remain pending; network validation and full army legality are uncertified."},
	"phobos-shadow-strike-from-the-shadows": {"category": CATEGORY_STRATAGEM, "name": "Strike from the Shadows (Phobos Shadow Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "1 CP when a friendly hidden PHOBOS unit is selected to attack in its Shooting or Fight phase. Its attacks gain +1 Strength and Lethal Hits through the shared attack-profile path. The existing persisted declaration offers use or pass and resumes the attack. Hidden state requires every living model to pass the local Hidden check. This is distinct from the identical Phobos Shock Force entry and is enabled only by Phobos Shadow Force. Focused checks and playtesting remain pending; network validation and full army legality are uncertified."},
	"phobos-shadow-masters": {"category": CATEGORY_DETACHMENT, "name": "Shadow Masters (Phobos Shadow Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26", "validation_status": "implemented_local_checks_pending", "scope": "After a friendly PHOBOS or SCOUT SQUAD unit shoots in its own Shooting phase, choose to let those attacks preserve Hidden eligibility for the current turn, or make a D6-inch Normal Move through shared per-model placement, terrain and coherency checks; moving blocks Charge until end of turn. Focused local checks and playtesting remain pending; network validation and full army legality are uncertified."},
	"phobos-shadow-venator-omni-auspex": {"category": CATEGORY_ENHANCEMENT, "name": "Venator Omni-auspex (Phobos Shadow Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "15 points; the verified local enhancement relation maps this model-only enhancement to four current-catalog PHOBOS bearer identities. In Phobos Shadow Force, attacks by the bearer's unit that target a unit whose every living model satisfies the local Hidden check re-roll natural Wound rolls of 1; while Assault Doctrine is active for the attacking unit, natural 1s and 2s are eligible. Successful natural 2s are offered as optional free re-roll choices through the persisted Wound checkpoint. Focused checks and playtesting remain pending; network validation and full army legality are uncertified."},
	"phobos-shadow-execute-and-redeploy": {"category": CATEGORY_ENHANCEMENT, "name": "Execute and Redeploy (Phobos Shadow Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "25 points; the verified local enhancement relation maps this model-only enhancement to four current-catalog PHOBOS bearer identities. After the unit shoots in its own Shooting phase, it may make a Normal Move up to 6 inches if unengaged; if it moves, it cannot declare a Charge until turn end. The shared placement path enforces the one-Normal-Move-per-phase limit, terrain, base overlap, coherency and ending unengaged. When Shadow Masters also triggers, that detachment choice resolves first; the Execute and Redeploy use/pass choice follows. Focused checks and playtesting remain pending; network validation and full army legality are uncertified."},
	"phobos-shock-transhuman-reactions": {"category": CATEGORY_STRATAGEM, "name": "Transhuman Reactions (Phobos Shock Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26", "validation_status": "implemented_local_checks_pending", "scope": "1 CP after an enemy unit ends a move within 8 inches of a friendly unengaged PHOBOS unit during the opponent's Movement phase. The PHOBOS unit makes a Normal Move up to D6 inches, or up to 6 inches if Tactical Doctrine is active for it. Uses the persisted post-move reaction and shared movement preview/confirmation; no Charge restriction is added. Focused checks and playtesting remain pending; network validation and full army legality are uncertified."},
	"phobos-shadow-mortis-snares": {"category": CATEGORY_STRATAGEM, "name": "Mortis Snares (Phobos Shadow Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "1 CP at the end of your Movement phase for one unengaged friendly PHOBOS or SCOUT SQUAD unit controlling one or more objectives; the local implementation arms each objective it controls. When an enemy unit ends a move within range of a snared objective, the snare is consumed and its owner rolls a D6; on 2+, a second D6 determines mortal wounds against the moving unit. The persisted trigger, damage and normal defender allocation windows preserve nested movement reactions; mortal wounds use shared prevention and Deadly Demise. Ingress setup does not count as ending a move for this trigger. Focused checks, playtesting, network validation and full army legality remain pending."},
	"phobos-shadow-tactical-withdrawal": {"category": CATEGORY_STRATAGEM, "name": "Tactical Withdrawal (Phobos Shadow Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "1 CP at the end of the opponent's Fight phase; place one friendly unengaged PHOBOS or SCOUT SQUAD unit in Strategic Reserves. The runtime requires a current admitted reserve cost, records the unit in the existing reserves state, removes its living models from the battlefield and deployment order, and reuses normal ingress later. Shared CP discounts and phase/unit use gates apply. Shadow Masters, Strike from the Shadows, Mortis Snares and both enhancements have separate supported entries. Focused checks, network validation and full army legality remain pending."},
	"phobos-shock-umbral-evasion": {"category": CATEGORY_STRATAGEM, "name": "Umbral Evasion (Phobos Shock Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26", "validation_status": "implemented_local_checks_pending", "scope": "1 CP in the opponent's Shooting phase when an enemy unit targets a friendly PHOBOS unit. The persisted attack-declaration reaction presents eligible PHOBOS targets from that declaration; the chosen unit gives -1 to Hit to ranged attacks targeting it for the phase through the shared attack modifier path. Focused checks and playtesting remain pending; network validation and full army legality are uncertified."},
	"phobos-shock-seal-of-shrouding": {"category": CATEGORY_ENHANCEMENT, "name": "Seal of Shrouding (Phobos Shock Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "15 points; the verified local enhancement relation maps this model-only enhancement to four current-catalog PHOBOS bearer identities. During the locally implemented Snap Shooting/Fire Overwatch path, the unit cannot be selected as a target. Both the target projection and attack-plan admission enforce the block before attack dice. Focused checks and playtesting remain pending; network validation and full army legality are uncertified."},
	"phobos-shock-venator-omni-auspex": {"category": CATEGORY_ENHANCEMENT, "name": "Venator Omni-auspex (Phobos Shock Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "15 points; the verified local enhancement relation maps this model-only enhancement to four current-catalog PHOBOS bearer identities. In Phobos Shock Force, attacks by the bearer's unit that target a unit whose every living model satisfies the local Hidden check re-roll natural Wound rolls of 1 and failed natural 2s while Assault Doctrine is active for the attacking unit. Successful natural 2s are offered as optional free re-roll choices through the persisted Wound checkpoint. Uses shared attack planning and re-roll choices. Focused checks and playtesting remain pending; network validation and full army legality are uncertified."},
	"black-winged-vigilance": {"category": CATEGORY_DETACHMENT, "name": "Black-winged Vigilance (Darkflight Pursuit)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_25", "validation_status": "implemented_local_checks_pending", "scope": "With current Dark Angels Chapter context, friendly current-reference Ravenwing FLY units' ranged attacks gain Ignores Cover and Outrider Squad units gain BATTLELINE. Darkflight Pursuit restriction is enforced against conflicting Chapter context and represented Chapter-faction keywords. Thundercowl Turbines, Nightforged Battery, Wings of Shadow, Skyborne Surveillance and We Are Vengeance have bounded runtime paths; focused checks, network validation and full army legality remain pending."},
	"thundercowl-turbines": {"category": CATEGORY_ENHANCEMENT, "name": "Thundercowl Turbines (Darkflight Pursuit)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_25", "validation_status": "implemented_local_checks_pending", "scope": "15 points; current export-linked Ravenwing-eligible Fly or Mounted bearer identities can make an ingress move in their owner's first Movement phase. Availability requires Darkflight Pursuit, a living active bearer, and the current Dark Angels Chapter context's RAVENWING keyword. The exception uses the shared ingress preview, edge/enemy/deployment-zone and coherency validation; it does not grant opponent-phase Rapid Ingress. Focused checks, human playtest, network validation and full army legality remain pending."},
	"nightforged-battery": {"category": CATEGORY_ENHANCEMENT, "name": "Nightforged Battery (Darkflight Pursuit)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_25", "validation_status": "implemented_local_checks_pending", "scope": "10 points; source-restricted to Land Speeder Vengeance datasheet 000000242 under Darkflight Pursuit. With current unit abilities enabled, the unit can choose to re-roll the random D6 result for its weapon Attack characteristic during attack generation and Hazard dice before mortal-wound allocation. Each Hazard die can be re-rolled once; after accepting the free re-roll choices, an otherwise eligible Command Re-roll can still be used on a different Hazard die. Focused checks, network validation and full army legality remain pending; Land Speeder Vengeance remains outside new construction choices until its focused local checks pass."},
	"darkflight-wings-of-shadow": {"category": CATEGORY_STRATAGEM, "name": "Wings of Shadow (Darkflight Pursuit)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_25", "validation_status": "implemented_local_checks_pending", "scope": "1 CP in the opponent's Shooting phase when an enemy declares attacks against a friendly Ravenwing Fly or Mounted unit. The defending player can grant the target Stealth for that Shooting phase before dice, using the existing cover and Ignore Cover attack path. Requires Darkflight Pursuit and Dark Angels Chapter context. Focused checks and human playtest remain pending; network validation and full army legality are uncertified."},
	"darkflight-skyborne-surveillance": {"category": CATEGORY_STRATAGEM, "name": "Skyborne Surveillance (Darkflight Pursuit)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_25", "validation_status": "implemented_local_checks_pending", "scope": "1 CP after a friendly Ravenwing FLY unit has shot in your Shooting phase. The controller can mark enemy units that are visible to any model in that unit and within 6 inches; those enemy units gain +3 detection range until the end of the Shooting phase, as implied by Core Rules 01.02.02 for phase-triggered effects without a stated duration. Detection-range checks use the shared terrain/visibility calculation. Requires Darkflight Pursuit and Dark Angels Chapter context. Focused local checks, human playtest, network validation and full army legality remain pending."},
	"darkflight-we-are-vengeance": {"category": CATEGORY_STRATAGEM, "name": "We Are Vengeance (Darkflight Pursuit)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_25", "validation_status": "implemented_local_checks_pending", "scope": "1 CP, once per phase, after an enemy unit in the opponent's Shooting phase has shot a friendly unengaged Ravenwing FLY unit. The defender can choose an eligible target and make a normal move up to D3+3 inches through the existing preview and confirm flow; target must remain unengaged. Requires Darkflight Pursuit and Dark Angels Chapter context. Focused checks, human playtest, network validation and full army legality remain pending."},
	"ironstorm-redoubtable-machine-spirit": {"category": CATEGORY_ENHANCEMENT, "name": "Redoubtable Machine Spirit (Ironstorm)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "25 points; exact local enhancement-to-datasheet eligibility filtered to Vehicle units excluding Transport-role, Fly and Walker datasheets. Grants a 5+ invulnerable save and restores 1 lost wound at the end of the owner's Command phase."},
	"ironstorm-gunnery-honours": {"category": CATEGORY_ENHANCEMENT, "name": "Gunnery Honours (Ironstorm)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "15 points; exact local enhancement-to-datasheet eligibility filtered to Vehicle units excluding Transport-role, Fly and Walker datasheets. The assigned unit's ranged profiles gain Heavy."},
	"lord-of-the-ravenwing": {"category": CATEGORY_ENHANCEMENT, "name": "Lord of the Ravenwing (Wrath of the Rock)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "tests_passed_local_targeted", "scope": "15 points; the current local catalog offers the source-export-eligible Chaplain on Bike and Captain on Bike only. In a Wrath of the Rock match, its assigned unit can optionally re-roll both Charge dice once after a Charge roll; the new result is mandatory. Full Dark Angels army legality is not certified."},
	"ancient-weapons": {"category": CATEGORY_ENHANCEMENT, "name": "Ancient Weapons (Wrath of the Rock)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "implemented_local_checks_pending", "scope": "20 points; source-relation-gated to 23 eligible identities in the current local Marine catalog, including the newly source-linked Apothecary, Chaplain, Judiciar and Lieutenant in Phobos Armour, plus Ancient, Bladeguard Ancient, Apothecary Biologis and Captain in Gravis Armour. The complete current identity list is recorded in the rules ledger. In a Wrath of the Rock match, the assigned bearer model's melee attacks gain +2 Strength and +1 AP. Bladeguard Ancient and Ancient in Terminator Armour still omit their source-listed DEATHWING keywords in the shared profiles; these identity links do not resolve those keyword gaps. Focused local checks remain pending; full Dark Angels army legality is not certified."},
	"champion-of-the-deathwing": {"category": CATEGORY_ENHANCEMENT, "name": "Champion of the Deathwing (Inner Circle Task Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21_plus_space_marines_app_2_8_1_observed_2026_10_26", "validation_status": "implemented_local_checks_pending", "scope": "20 points; the verified local export maps this enhancement to five DEATHWING datasheet IDs, all five present in the current Marine catalog. It is selectable only in Inner Circle Task Force. The bearer's unit gains Sustained Hits 1 against enemy units within range of its owner's active Vowed objective. Current Dark Angels context applies conditional DEATHWING keywords in match state. Focused checks, network validation and full army legality remain pending."},
	"deathwing-assault": {"category": CATEGORY_ENHANCEMENT, "name": "Deathwing Assault (Wrath of the Rock)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "implemented_local_checks_pending", "scope": "15 points; selectable only for the four source-related current catalog Terminator profiles whose local datasheet abilities include Deep Strike. In battle round 1, the enhanced unit may make an ingress move during its own first Movement phase. Ingress models must be wholly within 6 inches of a battlefield edge, more than 8 inches horizontally from every enemy unit and outside the opponent's deployment zone before battle round 3. This does not enable Rapid Ingress during the opponent's first Movement phase. The export also links Bladeguard Ancient, whose local datasheet has no Deep Strike; that profile is excluded. Ancient in Terminator Armour retains its known omitted DEATHWING keyword in the shared profile; this enhancement uses the exact export identity and local Deep Strike ability, and broader keyword reconciliation remains open. Focused local checks remain pending; full Dark Angels army legality is not certified."},
	"tempered-in-battle": {"category": CATEGORY_ENHANCEMENT, "name": "Tempered in Battle (Wrath of the Rock)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "tests_passed_local_targeted", "scope": "10 points; eligible Adeptus Astartes bearer, available in the local construction catalog under Wrath of the Rock. Friendly Adeptus Astartes units within 6 inches can optionally re-roll both dice for Leadership tests in Command Battle-shock, Desperate Escape, Fearsome Assault and Adamantine Terror; pending results and continuations survive serialization and resume after the choice. Separate player detachments are supported in prepared matches. Network validation and full Dark Angels army legality remain uncertified."},
	"ironstorm-layered-ceramite": {"category": CATEGORY_STRATAGEM, "name": "Layered Ceramite (Ironstorm)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "tests_passed_local_targeted", "scope": "1 CP, any phase when a friendly Adeptus Astartes Vehicle suffers a mortal wound. Offers the reaction before allocation for locally implemented sources, including Devastating Wounds, Hazardous, Deadly Demise, Explosives, Tank Shock, Hammer of Wrath, Haywire Mine, Telepathic Assault and Desperate Escape; grants Feel No Pain 5+ against mortal wounds for the current phase. The locally supported Space Marine transport records require Infantry passengers, so Emergency Disembark Hazard has no legal Marine Vehicle target. Devastating Wounds attacks against an eligible Vehicle use the allocation path so this reaction is not skipped by automatic attack resolution."},
	"medusa-spirits-of-iron": {"category": CATEGORY_STRATAGEM, "name": "Spirits of Iron (Medusa's Wrath)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21_plus_space_marines_app_2_8_1_observed_2026_10_26", "validation_status": "implemented_local_checks_pending", "scope": "1 CP, any phase when a friendly Adeptus Astartes unit suffers a mortal wound. Offers the reaction before allocation in locally modeled mortal-wound windows and grants Feel No Pain 5+ against mortal wounds through the current phase. Requires Medusa's Wrath and Iron Hands Chapter context. Focused local checks and human playtesting remain pending; network validation and full army legality are uncertified."},
	"medusa-vengeful-animus": {"category": CATEGORY_STRATAGEM, "name": "Vengeful Animus (Medusa's Wrath)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21_plus_space_marines_app_2_8_1_observed_2026_10_26", "validation_status": "implemented_local_checks_pending", "scope": "1 CP after a friendly Adeptus Astartes Vehicle unit is destroyed and before its Deadly Demise roll. Offers an optional reaction and changes every Deadly Demise D6 made for that unit to an unmodified 6. Requires Medusa's Wrath and Iron Hands Chapter context. Focused local checks and human playtesting remain pending; network validation and full army legality are uncertified."},
	"medusa-methodical-brutality": {"category": CATEGORY_STRATAGEM, "name": "Methodical Brutality (Medusa's Wrath)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21_plus_space_marines_app_2_8_1_observed_2026_10_26", "validation_status": "implemented_local_checks_pending", "scope": "1 CP when a friendly Adeptus Astartes unit is selected to attack in your Shooting phase or the Fight phase. Offers the optional choice before attack preparation; its attacks gain Sustained Hits 1 and Vehicle units also gain +1 to Wound rolls for the phase. Requires current unit abilities, Medusa's Wrath and Iron Hands Chapter context. Focused local checks and human playtesting remain pending; network validation and full army legality are uncertified."},
	"medusa-unbowed-conviction": {"category": CATEGORY_STRATAGEM, "name": "Unbowed Conviction (Medusa's Wrath)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21_plus_space_marines_app_2_8_1_observed_2026_10_26", "validation_status": "implemented_local_checks_pending", "scope": "1 CP in your Command phase for a friendly Adeptus Astartes unit below Starting Strength. Until the start of your next Command phase, its attacks ignore modifiers to BS/WS characteristics and Hit/Wound rolls. Below Starting Strength is based on models lost, not wounds suffered by a surviving model. Requires current unit abilities, Medusa's Wrath and Iron Hands Chapter context. Focused local checks and human playtesting remain pending; network validation and full army legality are uncertified."},
	"medusa-ancient-fury": {"category": CATEGORY_STRATAGEM, "name": "Ancient Fury (Medusa's Wrath)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21_plus_space_marines_app_2_8_1_observed_2026_10_26", "validation_status": "implemented_local_checks_pending", "scope": "1 CP in your Command phase for a friendly Adeptus Astartes Dreadnought unit. Until the start of your next Command phase, it gains +1 inch Move, +1 Toughness, +1 Leadership, +1 OC per model and +1 to Hit rolls through the shared Movement, defender profile, Leadership, objective-control and attack-modifier paths. Requires current unit abilities, Medusa's Wrath and Iron Hands Chapter context. Focused local checks and human playtesting remain pending; network validation and full army legality are uncertified."},
	"medusa-power-of-the-machine-spirit": {"category": CATEGORY_STRATAGEM, "name": "Power of the Machine Spirit (Medusa's Wrath)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21_plus_space_marines_app_2_8_1_observed_2026_10_26", "validation_status": "implemented_local_checks_pending", "scope": "1 CP in the opponent's Shooting phase after an enemy unit shoots a friendly unengaged Adeptus Astartes Vehicle. The trigger snapshots unengaged status from the attack plan before damage; the defender may choose one surviving eligible Vehicle. It shoots only the triggering enemy, using unmodified 6 Snap shooting (no hit re-rolls or critical hits) unless it is at half-strength or below, when normal shooting is used. Requires current unit abilities, Medusa's Wrath and Iron Hands Chapter context. Focused local checks and human playtesting remain pending; network validation and full army legality are uncertified."},
	"medusa-armoured-wrath": {"category": CATEGORY_DETACHMENT, "name": "Armoured Wrath (Medusa's Wrath)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21_plus_space_marines_app_2_8_1_observed_2026_10_26", "validation_status": "implemented_local_checks_pending", "scope": "When a friendly Adeptus Astartes unit is selected to shoot or fight, it can re-roll one Hit, Wound or Damage roll. If it is within 6 inches of a friendly Iron Father Feirros unit, it can instead re-roll one of each. The effect uses the shared persisted attack-resolution choices. Requires current unit abilities, Medusa's Wrath and Iron Hands Chapter context. Focused local checks and human playtesting remain pending; network validation and full army legality are uncertified."},
	"medusa-target-augury-web": {"category": CATEGORY_ENHANCEMENT, "name": "Target Augury Web (Medusa’s Wrath)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21_plus_space_marines_app_2_8_1_observed_2026_10_26", "validation_status": "implemented_local_checks_pending", "scope": "30 points; export relation rows 000000140 and 000000306 resolve to Techmarine and Iron Priest, but only Techmarine is present in the current catalog. At the start or end of the bearer unit’s Movement-phase move, select one friendly Adeptus Astartes Vehicle model within 3 inches of any model in the bearer unit; that model’s ranged and melee attacks gain Lethal Hits until the start of the owner’s next Command phase. Requires Medusa’s Wrath and Iron Hands Chapter context. Focused checks, network validation and full army legality remain pending."},
	"medusa-master-of-machine-war": {"category": CATEGORY_ENHANCEMENT, "name": "Master of the Machine War (Medusa’s Wrath)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21_plus_space_marines_app_2_8_1_observed_2026_10_26", "validation_status": "implemented_local_checks_pending", "scope": "25 points; enhancement row 000011180004 has relation entries for 37 datasheets, 23 of which resolve to current consolidated Marine profiles. In the owner's Movement phase, a living bearer selects one visible friendly Adeptus Astartes Vehicle unit within 6 inches and chooses Devastator or Tactical Doctrine. That doctrine is added to the Vehicle unit until the start of the owner's next Command phase; the choice is recorded by the shared once-per-battle doctrine ledger. Requires Medusa’s Wrath and Iron Hands Chapter context. Focused checks, network validation and full army legality remain pending."},
	"medusa-adept-of-the-omnissiah": {"category": CATEGORY_ENHANCEMENT, "name": "Adept of the Omnissiah (Medusa's Wrath)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21_plus_space_marines_app_2_8_1_observed_2026_10_26", "validation_status": "implemented_local_checks_pending", "scope": "25 points; local export row 000011180003 links Techmarine (000000140) and Iron Priest (000000306), but only Techmarine is in the current catalog. Once per battle round per army, when an enemy targets a friendly Astartes Vehicle within 6 inches of the bearer unit, the defender may grant it Feel No Pain 5+ against that enemy's attack. The reaction opens in Shooting/Fight attack declarations and the shared damage-prevention path retains the effect through the triggering attack. Requires current unit abilities and Medusa's Wrath with Iron Hands Chapter context. Focused checks, human playtesting, network validation and full army legality remain pending."},
	"medusa-the-flesh-is-weak": {"category": CATEGORY_ENHANCEMENT, "name": "The Flesh is Weak (Medusa's Wrath)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21_plus_space_marines_app_2_8_1_observed_2026_10_26", "validation_status": "implemented_local_checks_pending", "scope": "15 points; exact export relation provides 23 current-catalog bearer identities. The bearer model gains +1 Toughness and Feel No Pain 5+ against any wound through its model defense and prevention paths. Attached-unit Toughness continues to use the existing bodyguard profile while Bodyguard models remain. Requires Medusa's Wrath and Iron Hands Chapter context. Focused checks and human playtesting remain pending; network validation and full army legality are uncertified."},
	"ironstorm-might-of-the-machine-spirit": {"category": CATEGORY_STRATAGEM, "name": "Might of the Machine Spirit (Ironstorm)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "tests_passed_local_targeted", "scope": "1 CP in your Command phase; a friendly Adeptus Astartes Vehicle excluding Dedicated Transport, Fly and Walker ignores Move and Hit/Wound roll modifiers until the start of your next Command phase. Direct BS/WS characteristic modifiers use the shared weapon-profile path and are ignored while this ability is active. No other admitted Marine runtime source currently generates direct BS/WS modifiers."},
	"ironstorm-headhunter-doctrine": {"category": CATEGORY_STRATAGEM, "name": "Headhunter Doctrine (Ironstorm)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "tests_passed_local_targeted", "scope": "1 CP when an eligible friendly Ironstorm Vehicle is selected to shoot in your Shooting phase; its ranged attacks gain Lethal Hits only against MONSTER or VEHICLE targets. The decision is bound to the attack declaration before attack profiles are prepared."},
	"spearpoint-spear-thrust-and-sabre-swing": {"category": CATEGORY_STRATAGEM, "name": "Spear Thrust and Sabre Swing (Spearpoint)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "When an Adeptus Astartes unit is selected to fight, spend 1 CP: its melee attacks gain Lethal Hits or Lance; if it has Mounted, they gain both. Effects apply through the end of the Fight phase."},
	"spearpoint-flawless-riders": {"category": CATEGORY_STRATAGEM, "name": "Flawless Riders (Spearpoint)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "In your Movement or Charge phase, when a friendly Adeptus Astartes Mounted unit is selected to move or declares a charge, spend 1 CP; it gains Mobile for that phase."},
	"wrath-of-the-rock-knights-of-iron": {"category": CATEGORY_STRATAGEM, "name": "Knights of Iron (Wrath of the Rock)", "supported": true, "source_status": "wahapedia_e11_space_marines_faction_page_v2_8_1_observed_2026_10_26", "validation_status": "local_checks_pending", "scope": "In your Movement or Charge phase, when a friendly Ravenwing unit is selected to move or declares a charge, spend 1 CP; it gains Mobile for that phase. The bounded runtime recognizes explicit RAVENWING profiles and Dark Angels ADEPTUS ASTARTES Mounted or Vehicle Fly units; focused local checks are pending."},
	"wrath-of-the-rock-lions-will": {"category": CATEGORY_STRATAGEM, "name": "Lion's Will (Wrath of the Rock)", "supported": true, "source_status": "wahapedia_e11_space_marines_faction_page_v2_8_1_observed_2026_10_26", "validation_status": "local_checks_pending", "scope": "In your Command phase, target one friendly Adeptus Astartes unit within objective range; spend 1 CP to give each model in the unit +1 OC until the end of the turn. Focused local checks are pending."},
	"wrath-of-the-rock-tactical-mastery": {"category": CATEGORY_STRATAGEM, "name": "Tactical Mastery (Wrath of the Rock)", "supported": true, "source_status": "wahapedia_e11_space_marines_faction_page_v2_8_1_observed_2026_10_26", "validation_status": "local_checks_pending", "scope": "In your Command phase, spend 1 CP for one friendly Deathwing or Ravenwing unit and select one Combat Doctrine; it is active for that unit until the start of your next Command phase. The bounded runtime recognizes explicit keywords and current local-profile conditional grants; focused local checks are pending."},
	"wrath-of-the-rock-inescapable-justice": {"category": CATEGORY_STRATAGEM, "name": "Inescapable Justice (Wrath of the Rock)", "supported": true, "source_status": "wahapedia_e11_space_marines_faction_page_v2_8_1_observed_2026_10_26", "validation_status": "local_checks_pending", "scope": "In your Fight phase, when a friendly Adeptus Astartes unit is selected to fight, spend 1 CP; its melee attacks gain Precision for the phase. Focused local checks are pending."},
	"wrath-of-the-rock-relics-of-the-dark-age": {"category": CATEGORY_STRATAGEM, "name": "Relics of the Dark Age (Wrath of the Rock)", "supported": true, "source_status": "wahapedia_e11_space_marines_faction_page_v2_8_1_observed_2026_10_26", "validation_status": "local_checks_pending", "scope": "In your Shooting phase, when a friendly Adeptus Astartes Infantry or Mounted unit is selected to shoot, spend 1 CP; its ranged attacks gain +2 Strength for the phase. The bounded runtime uses current unit keywords; focused local checks are pending."},
	"wrath-of-the-rock-in-sacrifice-victory": {"category": CATEGORY_STRATAGEM, "name": "In Sacrifice, Victory (Wrath of the Rock)", "supported": true, "source_status": "wahapedia_e11_space_marines_faction_page_v2_8_1_observed_2026_10_26", "validation_status": "local_checks_pending", "scope": "In any game phase, when a friendly Deathwing or Ravenwing unit within objective range is destroyed, its controller may spend 1 CP to secure an objective with no enemy non-Aircraft unit in range or one that unit controlled at the end of the previous phase. The runtime snapshots squads contributing to objective control, waits until current destruction choices finish, and routes the normalized response to the destroyed unit's owner. Focused local checks and human playtest remain pending."},
	"spearpoint-evasive-manoeuvres": {"category": CATEGORY_STRATAGEM, "name": "Evasive Manoeuvres (Spearpoint)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "When an enemy Shooting attack targets a friendly Adeptus Astartes Mounted/Speeder unit, spend 1 CP; ranged attacks targeting it have -1 to Wound for that Shooting phase."},
	"spearpoint-mobile-lethality": {"category": CATEGORY_STRATAGEM, "name": "Mobile Lethality (Spearpoint)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "When a friendly Adeptus Astartes unit is selected to Advance or Fall Back in your Movement phase, spend 1 CP; its Fall Back does not prevent it from being eligible to shoot this turn, and its ranged attacks gain Assault this turn."},
	"spearpoint-withdraw-and-regroup": {"category": CATEGORY_STRATAGEM, "name": "Withdraw and Regroup (Spearpoint)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "At the end of your opponent's Fight phase, spend 1 CP to place one friendly, unengaged Adeptus Astartes Mounted/Speeder unit into Strategic Reserves."},
	"spearpoint-hunters-instincts": {"category": CATEGORY_STRATAGEM, "name": "Hunter's Instincts (Spearpoint)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "When an enemy unit ends a move within 8 inches in your opponent's Movement phase, an unengaged friendly Adeptus Astartes Infantry/Mounted/Speeder unit can spend 1 CP to make a Normal Move up to D3+3 inches."},
	"assault-brethren-gene-wrought-might": {"category": CATEGORY_STRATAGEM, "name": "Gene-Wrought Might (Assault Brethren)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "When a friendly Adeptus Astartes unit is selected to fight, spend 1 CP; its melee attacks gain Lance and, if Assault Doctrine is active for the unit, +1 AP for the Fight phase."},
	"assault-brethren-armour-of-contempt": {"category": CATEGORY_STRATAGEM, "name": "Armour of Contempt (Assault Brethren)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "In the opponent's Shooting phase or either Fight phase, after an enemy unit targets a friendly Adeptus Astartes unit, spend 1 CP; attacks from that enemy unit worsen AP by 1 until it has attacked."},
	"assault-brethren-duty-in-death": {"category": CATEGORY_STRATAGEM, "name": "Duty in Death (Assault Brethren)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "When an enemy unit targets a friendly Adeptus Astartes unit in the Fight phase, spend 1 CP; when its model is destroyed before it fights, roll D6 (+1 if Assault Doctrine is active for the unit), and on 4+ keep it until it fights or the phase ends."},
	"tactical-brethren-armour-of-contempt": {"category": CATEGORY_STRATAGEM, "name": "Armour of Contempt (Tactical Brethren)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Opponent Shooting or Fight phase, when an enemy targets a friendly Adeptus Astartes unit; its attacks against that unit worsen AP by 1 until it has attacked."},
	"tactical-brethren-domination-fire": {"category": CATEGORY_STRATAGEM, "name": "Domination Fire (Tactical Brethren)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "After a friendly Adeptus Astartes unit shoots, select one enemy unit hit by those attacks; it is suppressed until the start of your next turn and its attacks have -1 to Hit."},
	"tactical-brethren-masterful-tactics": {"category": CATEGORY_STRATAGEM, "name": "Masterful Tactics (Tactical Brethren)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Opponent Movement phase, after an enemy ends a move within 8 inches of a friendly unengaged Adeptus Astartes Infantry/Mounted unit; make a Normal Move up to D6 inches, or up to 6 inches with Tactical Doctrine."},
	"tactical-brethren-laurels-of-vigilance": {"category": CATEGORY_ENHANCEMENT, "name": "Laurels of Vigilance", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "10 points; eligible Adeptus Astartes model. Once per battle round per army, Fire Overwatch or Heroic Intervention targeting a friendly Adeptus Astartes Battleline unit within 12 inches of the bearer costs 1 fewer CP."},
	"tactical-brethren-tactical-insight": {"category": CATEGORY_ENHANCEMENT, "name": "Tactical Insight", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "15 points; eligible Captain model; Tactical Doctrine is active for the bearer's unit in addition to any other Combat Doctrine."},
	"devastator-brethren-armour-of-contempt": {"category": CATEGORY_STRATAGEM, "name": "Armour of Contempt (Devastator Brethren)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Opponent Shooting or Fight phase, when an enemy targets a friendly Adeptus Astartes unit; its attacks against that unit worsen AP by 1 until it has attacked."},
	"devastator-brethren-hail-of-vengeance": {"category": CATEGORY_STRATAGEM, "name": "Hail of Vengeance", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "2 CP; after an enemy unit shoots and destroys a model in a friendly Adeptus Astartes unit, that unit shoots normally but can target only the destroying enemy unit."},
	"devastator-brethren-storm-of-fire": {"category": CATEGORY_STRATAGEM, "name": "Storm of Fire", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "1 CP; when a friendly Adeptus Astartes unit is selected to shoot, its ranged attacks gain Ignores Cover; while Devastator Doctrine is active, they also gain +1 AP."},
	"devastator-brethren-master-forged-firearms": {"category": CATEGORY_ENHANCEMENT, "name": "Master-forged Firearms", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "15 points; eligible Astartes Infantry/Mounted bearer gains +1 Attack, Strength, AP and Damage on ranged attacks, excluding Psychic attacks."},
	"devastator-brethren-honour-of-vigilance": {"category": CATEGORY_ENHANCEMENT, "name": "Honour of Vigilance", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "20 points; ranged attacks by the bearer's unit gain Lethal Hits; while Devastator Doctrine is active, that unit may re-roll Advance rolls."},
	"assault-brethren-imperiums-sword": {"category": CATEGORY_ENHANCEMENT, "name": "Imperium's Sword (Assault Brethren)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Eligible Adeptus Astartes model in the local enhancement datasheet export; +20 points; bearer gains a melee weapon with 6 attacks, WS 2+, Strength 7, AP -3, Damage 3."},
	"assault-brethren-furious-assault": {"category": CATEGORY_ENHANCEMENT, "name": "Furious Assault (Assault Brethren)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Eligible Adeptus Astartes Infantry unit in the local enhancement datasheet export; +10 points; melee attacks gain Sustained Hits 1 against targets without Monster or Vehicle."},
	"stormlance-wind-swift-evasion": {"category": CATEGORY_STRATAGEM, "name": "Wind-Swift Evasion (Stormlance)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "At end of the Fight phase, a friendly Adeptus Astartes Mounted unit that was eligible to fight can make a Normal Move if unengaged or Fall Back if engaged; per-model Movement characteristic and Lightning-fast Strike allowance apply."},
	"stormlance-sudden-onslaught": {"category": CATEGORY_STRATAGEM, "name": "Sudden Onslaught (Stormlance)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "When a friendly Adeptus Astartes Mounted/Speeder unit is selected to Advance, spend 1 CP and replace its Advance D6 with 6 before modifiers; focused check confirms no D6 roll and Stormlance movement modifiers."},
	"stormlance-hurtling-targets": {"category": CATEGORY_STRATAGEM, "name": "Hurtling Targets (Stormlance)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "When the enemy declares a ranged attack targeting the unit, the Stormlance defender can spend 1 CP before dice; attacks targeting its Adeptus Astartes Mounted/Speeder unit suffer -1 to Hit for that Shooting phase."},
	"ironclad-mercy-is-weakness": {"category": CATEGORY_STRATAGEM, "name": "Mercy is Weakness (Ironclad Champions)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "tests_passed_local_targeted", "scope": "When a friendly Dreadnought is selected to attack in the Shooting or Fight phase, spend 1 CP and choose Lethal Hits or Sustained Hits 1 for that unit's attacks in the phase."},
	"ironclad-adamantine-terror": {"category": CATEGORY_STRATAGEM, "name": "Adamantine Terror (Ironclad Champions)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "tests_passed_local_targeted", "scope": "At the start of either player's Fight phase, spend 1 CP for a friendly Dreadnought; each enemy unit engaged with it takes a Battle-shock test at -1 to the roll. Eligible Tempered in Battle targets can suspend each result for their controller's full 2D6 reroll; targets resume sequentially and CP is spent once."},
	"ironclad-unstoppable-advance": {"category": CATEGORY_STRATAGEM, "name": "Unstoppable Advance (Ironclad Champions)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "tests_passed_local_targeted", "scope": "In your Movement or Charge phase, when a friendly Dreadnought unit is selected to move or declares a charge, spend 1 CP to give it Mobile for that phase; its Mobile trait uses the shared terrain movement rules."},
	"gauntlet-combined-deployment": {"category": CATEGORY_DETACHMENT, "name": "Combined Deployment (Gauntlet Task Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26", "validation_status": "implemented_local_checks_pending", "scope": "Partial Gauntlet Task Force rule. In your Shooting phase, after a friendly ADEPTUS ASTARTES TRANSPORT unit has shot, choose one enemy unit hit by those attacks or pass. The selected enemy is Assailed until end of turn. Friendly ADEPTUS ASTARTES units that disembarked this turn gain Sustained Hits 1 against that target through the shared target-specific attack-profile path. Linebreaker Onslaught and Damocles-class Uplink are available as separately bounded enhancement capabilities. Storm and Secure and Duty is Never Done are also available; Aggressive Disembarkation is partially available for supported Movement-phase disembark choices; other windows remain pending. Focused local checks, human playtesting, network validation and full army legality remain pending."},
	"gauntlet-storm-and-secure": {"category": CATEGORY_STRATAGEM, "name": "Storm and Secure (Gauntlet Task Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_and_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "Spend 1 CP at the end of your Movement phase for a friendly ADEPTUS ASTARTES TRANSPORT carrying a friendly ADEPTUS ASTARTES BATTLELINE unit; select an objective controlled by that Transport unit and secure it through the shared objective path. The shared stratagem gate enforces CP, one use per phase and one stratagem per target unit. Focused local checks, human playtesting, network validation and full army legality remain pending."},
	"gauntlet-duty-is-never-done": {"category": CATEGORY_STRATAGEM, "name": "Duty is Never Done (Gauntlet Task Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_and_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "At the end of the Fight phase, spend 1 CP for one friendly ADEPTUS ASTARTES INFANTRY unit that was eligible to fight this phase and is currently unengaged; every living model must be within 6 inches of a friendly Transport it is eligible to embark within. Eligibility checks the source transport profile, keywords and capacity; the stratagem's 6-inch wholly-within range is applied separately from normal Movement-phase embark requirements. The shared stratagem gate enforces discounts, one use per phase and one stratagem per target unit. The unit embarks through the shared transport mutation path. Focused local checks, human playtesting, network validation and full army legality remain pending."},
	"gauntlet-aggressive-disembarkation": {"category": CATEGORY_STRATAGEM, "name": "Aggressive Disembarkation (Gauntlet Task Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_and_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "Spend 1 CP when an embarked friendly ADEPTUS ASTARTES unit is selected for a supported Movement-phase disembark move. Each model may be set up within, rather than wholly within, its Transport's mode set-up distance. Current modes are rapid, tactical, combat, assault and shock when their Transport's move and abilities permit; Tactical mode eligibility also accounts for the relaxed range. The move's distance, engagement, coherency, Hazard, ingress and post-move restrictions remain in force. Standard disembark placements enforce wholly-within range. The shared stratagem gate enforces discounts, one use per phase and one stratagem per target unit. Emergency Disembark now offers this option before the required Hazard rolls, relaxes only the wholly-within 6-inch setup range, and preserves the as-close-as-possible rule, engagement fallback, Battle-shock and no-Charge restrictions; existing placement ownership remains with the active player. Before each mandatory Drop Pod Assault Rapid Disembark, the stratagem can be used after arrival, including after Rapid Ingress during the opponent's Movement phase; each passenger must still set up more than 8 inches from every enemy. Other out-of-phase selection contexts remain unsupported. Focused local checks, human playtesting, network validation and full army legality remain pending."},
	"linebreaker-onslaught": {"category": CATEGORY_ENHANCEMENT, "name": "Linebreaker Onslaught (Gauntlet Task Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_and_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "20 points; the verified local enhancement relation matches 21 current-catalog ADEPTUS ASTARTES INFANTRY identities. While its unit has disembarked this turn, the unit can re-roll Charge rolls and cannot be targeted by Snap Shooting attacks. Charge re-roll uses the persisted after-Charge decision; target protection covers the current Fire Overwatch and Power of the Machine Spirit Snap Shooting paths. Focused local checks, human playtesting, network validation and full army legality remain pending."},
	"oathbound-exemplar": {"category": CATEGORY_ENHANCEMENT, "name": "Oathbound Exemplar (Fist of the God-Emperor)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_plus_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "10 points; source-linked Adeptus Astartes Infantry units only. In Fist of the God-Emperor matches with Black Templars Chapter context, an Advance or Fall Back move no longer by itself blocks the unit from starting an otherwise eligible action. Other Action eligibility gates remain active. The detachment's other rules and stratagems remain unavailable. Focused checks, network validation and full army legality are pending."},
	"damocles-class-uplink": {"category": CATEGORY_ENHANCEMENT, "name": "Damocles-class Uplink (Gauntlet Task Force)", "supported": true, "source_status": "wahapedia_e11_space_marines_page_v2_8_1_observed_2026_10_26_and_local_export_20261021T130623Z", "validation_status": "implemented_local_checks_pending", "scope": "15 points; the verified local enhancement relation intersects six current-catalog Captain identities. During the bearer's active Movement phase while its unit is embarked in a living Transport, choose one friendly ADEPTUS ASTARTES INFANTRY unit with Combat Doctrines within 6 inches of that Transport and assign one unused Combat Doctrine until the start of the owner's next Command phase. One use per Movement phase; consumes that doctrine's shared once-per-battle selection. Focused checks, human playtesting, network validation and full army legality remain pending."},
	"artificer-sarcophagus": {"category": CATEGORY_DETACHMENT, "name": "Artificer Sarcophagus (Ironclad Champions)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "tests_passed_local_targeted", "scope": "40 points; eligible local Dreadnought unit only; attacks targeting it have Damage reduced by 1, minimum 1."},
	"venerable-champion-aura": {"category": CATEGORY_DETACHMENT, "name": "Venerable Champion (Aura, Ironclad Champions)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "tests_passed_local_targeted", "scope": "30 points; eligible local Dreadnought unit only; friendly Adeptus Astartes Infantry/Mounted units within 6 inches can re-roll hit rolls of 1."},
	"adept-of-the-codex": {"category": CATEGORY_DETACHMENT, "name": "Adept of the Codex (Gladius Task Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "20 points; eligible local CAPTAIN model only; its unit always has Tactical Doctrine in addition to any other active Combat Doctrine, including after attaching to a bodyguard."},
	"artificer-armour": {"category": CATEGORY_DETACHMENT, "name": "Artificer Armour (Gladius Task Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "15 points; eligible non-Epic-Hero Adeptus Astartes model only; its own Save characteristic becomes 2+ and it has Feel No Pain 5+. The assigned unit's first model is the bearer in the current roster format."},
	"laurels-of-triumph": {"category": CATEGORY_DETACHMENT, "name": "Laurels of Triumph (Gladius Task Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "20 points; eligible non-Epic-Hero Adeptus Astartes model only; its melee attacks gain +1 Strength/AP, or +2 while Assault Doctrine is active. Only attacks made by the roster-assigned bearer receive the bonus."},
	"spearpoint-stormseers-wisdom": {"category": CATEGORY_ENHANCEMENT, "name": "Stormseer's Wisdom (Spearpoint)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "15 points; exact local export eligibility; the assigned bearer’s unit may re-roll its Advance D6 once in the post-roll decision without CP."},
	"spearpoint-chogorian-huntmaster": {"category": CATEGORY_ENHANCEMENT, "name": "Chogorian Huntmaster (Spearpoint)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "20 points; exact local export eligibility for Mounted/Speeder datasheets; when selected to make an ingress move, the unit treats the current battle round as one higher, including round 1 arrival."},
	"spearpoint-hunters-eye": {"category": CATEGORY_ENHANCEMENT, "name": "Hunter’s Eye (Spearpoint)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "25 points; exact local export eligibility; ranged attacks by the bearer’s unit gain Ignores Cover and Sustained Hits 1."},
	"spearpoint-paragon": {"category": CATEGORY_ENHANCEMENT, "name": "Spearpoint Paragon", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "25 points; exact local export eligibility; only the assigned bearer’s melee attacks gain +1 Strength and AP, or +2 after its unit made a Charge move this turn."},
	"standard-of-the-emperor-ascendant": {"category": CATEGORY_DETACHMENT, "name": "Standard of the Emperor Ascendant (Gladius Task Force)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "25 points; eligible Ancient model only; the bearer gains +1 OC, improves its Leadership target by 1, and has Feel No Pain 5+. Once per battle per army, when its unit is selected to fight, it may gain +1 Attack on melee attacks until the phase ends."},
	"supercharged-engines": {"category": CATEGORY_DETACHMENT, "name": "Supercharged Engines (Stormlance)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "10 points; one eligible current local datasheet unit can re-roll its Advance roll without CP in the pending Movement decision."},
	"auspex-triangulation-shrines": {"category": CATEGORY_DETACHMENT, "name": "Auspex Triangulation Shrines (Stormlance)", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "10 points; eligible current local Speeder datasheet; at start of own Shooting phase select one visible enemy within 12 inches; one mark per bearer per Shooting phase; the persistent spotted mark adds 3 inches to detection range, following the export text which specifies no expiry."},
	"awakened-dynasty": {"category": CATEGORY_DETACHMENT, "name": "Awakened Dynasty: Command Protocols", "supported": true, "validation_status": "tests_passed_local_targeted", "scope": "Led Necron units; other detachment rules remain pending", "source_status": "wahapedia_e11_necrons_faction_page_v1_2_2026_08", "network_validation_status": "targeted_loopback"},
	# Core stratagems (implemented).
	"insane-bravery": {"category": CATEGORY_STRATAGEM, "name": "Insane Bravery", "supported": true, "validation_status": "tests_passed_local_targeted", "source_status": "wahapedia_e11_core_rules_current_2026_10_22", "scope": "Core Stratagem; Command phase Battle-shock test failure, one use per battle, available through the implemented phase-close decision window.", "network_validation_status": "targeted_loopback"},
	"rapid-ingress": {"category": CATEGORY_STRATAGEM, "name": "Rapid Ingress", "supported": true, "validation_status": "tests_passed_local_targeted", "scope": "Current-unit Terminator reserve workflow", "source_status": "wahapedia_e11_core_rules_current_2026_10_22"},
	"command-re-roll": {"category": CATEGORY_STRATAGEM, "name": "Command Re-roll", "supported": true, "validation_status": "tests_passed_local_targeted", "scope": "Checked matches enable every implemented Command Re-roll window", "source_status": "wahapedia_e11_core_rules_current_2026_10_22", "network_validation_status": "partial_loopback"},
	"epic-challenge": {"category": CATEGORY_STRATAGEM, "name": "Epic Challenge (15.03)", "supported": true, "validation_status": "tests_passed_local_targeted", "scope": "Core; melee Precision for a Character model after it is selected to fight", "source_status": "wahapedia_e11_core_rules_current_2026_10_22"},
	"explosives": {"category": CATEGORY_STRATAGEM, "name": "Explosives / Grenades (15.05)", "supported": true, "source_status": "wahapedia_e11_checked_2026_10_18", "validation_status": "tests_passed_local_targeted", "scope": "Core; eligible unengaged EXPLOSIVES/GRENADES model before shooting, no Advance; visible unengaged enemy within 8 inches; six D6, 4+ mortal wounds with defender allocation and Feel No Pain"},
	"crushing-impact": {"category": CATEGORY_STRATAGEM, "name": "Crushing Impact / Tank Shock (15.06)", "supported": true, "source_status": "wahapedia_e11_core_rules_current_2026_10_26", "validation_status": "implemented_local_checks_pending", "scope": "Core Rules §15.06. Immediately after a friendly MONSTER/VEHICLE unit ends a Charge move, choose one enemy unit engaged with your unit and one of your models engaged with that enemy. Roll D6 equal to the selected model's Toughness. Each 1 inflicts 1 mortal wound on your own unit; each 5+ inflicts 1 on the enemy, to a maximum of 6 against that unit. Resolve the charging unit's mortal wounds first, then the target's, with each unit's owner using shared allocation/prevention and Deadly Demise continuations. Brutalis Charge grants its documented free additional per-unit use. Focused local checks and playtesting are pending."},
	"brutalis-charge": {"category": CATEGORY_UNIT, "name": "Brutalis Charge", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Brutalis Dreadnought; once per phase per unit, Tank Shock costs 1 fewer CP and its use does not prevent Tank Shock on other units that phase."},
	"forward-assault-warsuit": {"category": CATEGORY_UNIT, "name": "Forward Assault Warsuit", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Invictor Tactical Warsuit; mark one enemy unit at the start of the first battle round, re-roll Wound rolls of 1 against the mark, and select a new mark each time the current mark is destroyed."},
	"fire-overwatch": {"category": CATEGORY_STRATAGEM, "name": "Fire Overwatch (15.08)", "supported": true, "validation_status": "tests_passed_local_targeted", "scope": "Core; end of opponent Movement, snap shooting (unmodified 6s, not critical hits, no hit rerolls)", "source_status": "wahapedia_e11_core_rules_current_2026_10_22"},
	"sentinel-protocols": {"category": CATEGORY_UNIT, "name": "Sentinel Protocols", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Firestrike Servo-turrets: once per phase per unit, may be targeted by Fire Overwatch regardless of other uses of the stratagem this phase; its snap shooting attacks hit on unmodified 4+ until that stratagem resolves. Snap shots do not become critical hits and cannot be re-rolled."},
	"damaged-4": {"category": CATEGORY_UNIT, "name": "Damaged 4", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Ballistus, Redemptor and Brutalis Dreadnoughts, Invictor Tactical Warsuit, Gladiator Reaper and Valiant, and Storm Speeders Hammerstrike, Hailstrike and Thunderstrike; while the model has 1–4 wounds remaining, its attacks have -1 to Hit."},
	"deadly-demise-d3": {"category": CATEGORY_UNIT, "name": "Deadly Demise D3", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "implemented_local_checks_pending", "scope": "Admitted Dreadnoughts, Invictor Tactical Warsuit, Gladiator Reaper and Valiant, Storm Speeders Hammerstrike, Hailstrike and Thunderstrike, and Land Speeder Vengeance; on a 6 after the model is destroyed, each unit within 6 inches suffers D3 mortal wounds, rolled separately per unit. Mortal wounds use normal allocation and prevention; chain destructions resolve in sequence. Land Speeder Vengeance and Medusa's Wrath Vengeful Animus integrations are implemented, but focused local checks remain pending."},
	"transport-deadly-demise": {"category": CATEGORY_UNIT, "name": "Marine transport Deadly Demise", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21_plus_core_rules_current_2026_10_26", "validation_status": "implemented_local_checks_pending", "scope": "Eight locally admitted Space Marine transport profiles: Land Raider, Land Raider Crusader and Land Raider Redeemer use D6; Drop Pod uses 1; Impulsor and Rhino use D3; Repulsor and Repulsor Executioner use D6. After any passenger Emergency Disembark continuation completes, a destroyed model rolls one D6; on a 6, each unit within 6 inches suffers the profile's X mortal wounds, rolled separately per unit for random X. Packets use shared allocation and prevention; chain destructions resolve in sequence. Medusa's Wrath Vengeful Animus can force the Deadly Demise D6 to 6 for eligible Astartes Vehicles. Focused local checks and playtesting remain pending; this does not certify other transport rules."},
	"storm-of-vengeance": {"category": CATEGORY_UNIT, "name": "Storm of Vengeance", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_21", "validation_status": "implemented_local_checks_pending", "scope": "Land Speeder Vengeance; once per turn per unit in the opponent's Shooting phase, after an enemy shooting activation destroys a friendly Dark Angels unit within 6 inches of this model, the defender may have this unit shoot the attacking enemy using its normal shooting rules. Reactive attack target and persisted Shooting-reaction frame are bound to that attacker. Multiple eligible Vengeance units may react sequentially. Focused local checks remain pending."},
	"executioner": {"category": CATEGORY_UNIT, "name": "Executioner", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Repulsor Executioner; its ranged attacks gain +1 to Hit when targeting an enemy unit that is not below half-strength. Exactly half-strength qualifies; below half-strength does not."},
	"power-of-the-machine-spirit": {"category": CATEGORY_UNIT, "name": "Power of the Machine Spirit", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Land Raider; during its ranged attack resolution, may re-roll one Hit roll and one Wound roll across its ranged attacks. Choices are optional, once each per attack activation, and hit re-rolls are unavailable for Snap Shooting or Indirect Fire."},
	"fury-of-the-machine-spirit": {"category": CATEGORY_UNIT, "name": "Fury of the Machine Spirit", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Land Raider Crusader; ranged attacks targeting an enemy unit within 12 inches gain Lethal Hits."},
	"wrath-of-the-machine-spirit": {"category": CATEGORY_UNIT, "name": "Wrath of the Machine Spirit", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Land Raider Redeemer; ranged attacks targeting a non-MONSTER, non-VEHICLE enemy unit within 12 inches gain Devastating Wounds."},
	"orbital-comms-array": {"category": CATEGORY_UNIT, "name": "Orbital Comms Array", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Impulsor optional system; add 10 points and grant the Impulsor Scouts 6 for the Core pre-battle Scout move."},
	"shield-dome": {"category": CATEGORY_UNIT, "name": "Shield Dome", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Impulsor optional system; the equipped model has a 5+ invulnerable save."},
	"combat-embarkation": {"category": CATEGORY_UNIT, "name": "Combat Embarkation", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Repulsor; during the opponent's Charge phase after charge targets are selected and before any charge model moves, the defender may embark one selected, unengaged friendly ADEPTUS ASTARTES unit eligible to embark and wholly within 3 inches; a unit set up this turn is excluded. The charger may then revise targets."},
	"reaping-tally": {"category": CATEGORY_UNIT, "name": "Reaping Tally", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Gladiator Reaper; its ranged attacks targeting a unit without the MONSTER or VEHICLE keyword gain +1 AP."},
	"priority-target-acquisition": {"category": CATEGORY_UNIT, "name": "Priority Target Acquisition", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Gladiator Valiant; its ranged attacks targeting a unit within 12 inches of this unit gain +1 Strength."},
	"hammerstrike": {"category": CATEGORY_UNIT, "name": "Hammerstrike", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Storm Speeder Hammerstrike; ranged attacks targeting an enemy unit within a terrain area gain Sustained Hits 1. A target unit qualifies when any living model base overlaps a current terrain area."},
	"hailstrike": {"category": CATEGORY_UNIT, "name": "Hailstrike", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Storm Speeder Hailstrike; in its own Shooting phase after it shoots, select one enemy unit hit by its attacks. Until phase end, friendly ADEPTUS ASTARTES ranged attacks against that unit gain Ignores Cover."},
	"thunderstrike": {"category": CATEGORY_UNIT, "name": "Thunderstrike", "supported": true, "source_status": "wahapedia_e11_local_export_2026_10_16", "validation_status": "tests_passed_local_targeted", "scope": "Storm Speeder Thunderstrike; its ranged attacks targeting a MONSTER or VEHICLE add 1 to the Wound roll."},
