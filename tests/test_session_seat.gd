extends SceneTree
const Seat = preload("res://scripts/session_seat.gd")
const Save = preload("res://scripts/match_save.gd")
const MatchSession = preload("res://scripts/network/match_session.gd")

func _initialize() -> void:
	var match_session = MatchSession.new()
	match_session.start_host()
	assert(not match_session.accepts_guest_command(0))
	assert(not match_session.accepts_guest_command(2))
	match_session.admit(2)
	assert(match_session.accepts_guest_command(2))
	assert(not match_session.accepts_guest_command(3))
	match_session.peer_disconnected(2)
	assert(not match_session.accepts_guest_command(2))
	var session := Seat.create()
	assert(Seat.valid_session(session))
	session.token = Seat.secret()
	var nonce := Seat.secret()
	var response := Seat.proof(session.token, nonce, session.id)
	assert(Seat.accepts(session, nonce, response))
	assert(not Seat.accepts(session, Seat.secret(), response))
	assert(not Seat.accepts(session, nonce, Seat.proof(Seat.secret(), nonce, session.id)))
	assert(not Seat.accepts(session, nonce, ""))
	assert(not Seat.valid_session({"id": "a", "token": "b"}))
	assert(Seat.remember(session.id, session.token).is_empty())
	assert(Seat.credentials().seats[session.id] == session.token)
	assert(Save.write({}, {}, 0, {}, Save.PATH, session).is_empty())
	assert(Save.read().session == session)
	assert(not var_to_str(Save.read().state).contains(session.token))
	var file := FileAccess.open(Seat.PATH, FileAccess.WRITE)
	file.store_string("corrupt")
	file.close()
	assert(Seat.credentials().has("error"))
	assert(not Seat.remember(session.id, session.token).is_empty())
	print("SESSION SEAT: PASS")
	quit()
